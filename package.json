{
  "name": "almost-for-ever",
  "version": "0.7.0",
  "type": "module",
  "description": "Persistent memory and a local Markdown knowledge base for DSH: recalls relevant notes every turn, with full-text search, a visual atlas, safe editing, and confirmed writes.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "memory",
    "persistent-memory",
    "long-term-memory",
    "agent-memory",
    "knowledge-base",
    "notes",
    "markdown",
    "context",
    "full-text-search",
    "local-first"
  ],
  "license": "MIT",
  "author": "zwebzzz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zwebzzz/almost-for-ever.git"
  },
  "homepage": "https://github.com/zwebzzz/almost-for-ever#readme",
  "bugs": {
    "url": "https://github.com/zwebzzz/almost-for-ever/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
